diff --git a/src/Main.cxx b/src/Main.cxx
index a2bc8ce..3151e1b 100644
--- a/src/Main.cxx
+++ b/src/Main.cxx
@@ -45,6 +45,15 @@
 #include "config/PartitionConfig.hxx"
 #include "util/ScopeExit.hxx"
 
+#include <atomic>
+#include <csignal>
+#include <cstdlib>
+#include <stdexcept>
+#include <thread>
+#include <unistd.h>
+
+int RunAudirvanaRenderer(std::stop_token stop, const char *config);
+
 #ifdef ENABLE_DAEMON
 #include "unix/Daemon.hxx"
 #endif
@@ -512,9 +521,31 @@ MainConfigured(const CommandLineOptions &options,
 	sd_notify(0, "READY=1");
 #endif
 
-	/* run the main loop */
+	/* Keep UPnP callbacks off the MPD event loop. They use the private
+	   Unix socket to issue commands to this instance. */
+	const char *renderer_config = std::getenv("UPNP_AUDIRVANA_CONFIG");
+	if (renderer_config == nullptr || *renderer_config == '\0')
+		renderer_config = "/etc/upnp-audirvana/renderer.conf";
+	if (geteuid() == 0)
+		throw std::runtime_error("Run upnp-audirvana as an unprivileged user");
+
+	std::atomic_bool renderer_failed{false};
+	std::jthread renderer([&](std::stop_token stop) {
+		try {
+			renderer_failed = RunAudirvanaRenderer(stop, renderer_config) != 0;
+		} catch (...) {
+			LogError(std::current_exception());
+			renderer_failed = true;
+		}
+		if (renderer_failed)
+			instance.event_loop.InjectBreak();
+	});
+
 	instance.event_loop.Run();
 
+	renderer.request_stop();
+	renderer.join();
+
 #ifdef _WIN32
 	win32_app_stopping();
 #endif
@@ -526,6 +557,8 @@ MainConfigured(const CommandLineOptions &options,
 
 	instance.BeginShutdownUpdate();
 	instance.BeginShutdownPartitions();
+	if (renderer_failed)
+		throw std::runtime_error("UPnP renderer failed");
 }
 
